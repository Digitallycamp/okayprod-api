{
	"openapi": "3.1.0",
	"info": {
		"title": "Okayprod Api",
		"summary": "This is an internal documentation for our team for all olayproudct api",
		"version": "1.1.0",
		"contact": {
			"name": "Mr Wisdom",
			"email": "team@okayprouct.com"
		},
		"license": {
			"name": "Apache 2.0"
		}
	},
	"paths": {
		"/health": {
			"get": {
				"tags": ["Health"],
				"description": "Check api health",
				"responses": {
					"200": {
						"description": "Server ruunign well",
						"content": {
							"application/json": {},
							"application/xml": {}
						}
					}
				}
			}
		},
		"/api/v1/auth/login": {
			"post": {
				"tags": ["Login"],
				"description": "Authenticate user",
				"requestBody": {
					"description": "Payoad data",
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["email", "password"],
								"properties": {
									"email": {
										"type": "string"
									},
									"password": {
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Login success",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"message": {
											"type": "string"
										}
									}
								}
							},
							"application/xml": {}
						}
					},
					"400": {
						"description": "Bad request",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"success": {
											"type": "boolean"
										},
										"message": {
											"type": "string"
										}
									}
								}
							},
							"application/xml": {}
						}
					}
				}
			}
		},
		"/api/v1/storefront": {
			"get": {
				"tags": ["Storefront"],
				"description": "Get the authenticated user's storefront settings",
				"responses": {
					"200": {
						"description": "Storefront retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"success": {
											"type": "boolean"
										},
										"message": {
											"type": "string"
										},
										"data": {
											"type": "object",
											"properties": {
												"_id": {
													"type": "string"
												},
												"user": {
													"type": "string"
												},
												"logo": {
													"type": "string",
													"nullable": true
												},
												"primaryBrandColor": {
													"type": "string"
												},
												"announcementBar": {
													"type": "boolean"
												},
												"messageContent": {
													"type": "string"
												}
											}
										}
									}
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"404": {
						"description": "Storefront not found for this user"
					}
				}
			},
			"patch": {
				"tags": ["Storefront"],
				"description": "Update the authenticated user's storefront settings",
				"requestBody": {
					"description": "Storefront fields to update",
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"primaryBrandColor": {
										"type": "string"
									},
									"announcementBar": {
										"type": "boolean"
									},
									"messageContent": {
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Storefront updated successfully",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"success": {
											"type": "boolean"
										},
										"message": {
											"type": "string"
										},
										"data": {
											"type": "object"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Bad request"
					},
					"401": {
						"description": "Unauthorized"
					},
					"404": {
						"description": "Storefront not found for this user"
					}
				}
			}
		},
		"/api/v1/storefront/logo": {
			"patch": {
				"tags": ["Storefront"],
				"description": "Upload a logo for the authenticated user's storefront. Accepts multipart/form-data with a field named 'logo'.",
				"requestBody": {
					"description": "Logo file",
					"required": true,
					"content": {
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"required": ["logo"],
								"properties": {
									"logo": {
										"type": "string",
										"format": "binary"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Logo updated successfully",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"success": {
											"type": "boolean"
										},
										"message": {
											"type": "string"
										},
										"data": {
											"type": "object",
											"properties": {
												"logo": {
													"type": "string"
												}
											}
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "No file provided, invalid file type, or file too large"
					},
					"401": {
						"description": "Unauthorized"
					},
					"404": {
						"description": "Storefront not found for this user"
					}
				}
			}
		}
	}
}